<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textAppearance="@style/TextAppearance.Magneetar.Headline2"
            android:textColor="@color/md_theme_onSurface"
            android:layout_marginBottom="20dp" />

        <!-- Device Selector -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Magneetar.Card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target Device"
                    android:textAppearance="@style/TextAppearance.Magneetar.Body1"
                    android:textColor="@color/md_theme_onSurface" />

                <Spinner
                    android:id="@+id/spinner_devices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:popupBackground="@color/md_theme_surfaceContainerHigh" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Command Grid Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Ring / Siren -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cmd_ring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                style="@style/Widget.Magneetar.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_action_ring"
                        android:contentDescription="Ring"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ring"
                        android:textAppearance="@style/TextAppearance.Magneetar.Subtitle2"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max volume alarm"
                        android:textAppearance="@style/TextAppearance.Magneetar.Caption"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lock -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cmd_lock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                style="@style/Widget.Magneetar.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_action_lock"
                        android:contentDescription="Lock"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lock"
                        android:textAppearance="@style/TextAppearance.Magneetar.Subtitle2"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lock device screen"
                        android:textAppearance="@style/TextAppearance.Magneetar.Caption"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Command Grid Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Locate -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cmd_locate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                style="@style/Widget.Magneetar.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_action_locate"
                        android:contentDescription="Locate"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Locate"
                        android:textAppearance="@style/TextAppearance.Magneetar.Subtitle2"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get current location"
                        android:textAppearance="@style/TextAppearance.Magneetar.Caption"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Capture -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cmd_capture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                style="@style/Widget.Magneetar.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_action_capture"
                        android:contentDescription="Capture"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture"
                        android:textAppearance="@style/TextAppearance.Magneetar.Subtitle2"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take photo + audio"
                        android:textAppearance="@style/TextAppearance.Magneetar.Caption"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Danger Zone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANGER ZONE"
            android:textAppearance="@style/TextAppearance.Magneetar.Overline"
            android:textColor="@color/md_theme_error"
            android:layout_marginBottom="12dp" />

        <!-- Wipe Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cmd_wipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Factory Reset"
            android:textColor="@color/md_theme_error"
            android:backgroundTint="@color/md_theme_errorContainer"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- Command Status -->
        <TextView
            android:id="@+id/tv_command_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/TextAppearance.Magneetar.Body2"
            android:textColor="@color/md_theme_primary"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
