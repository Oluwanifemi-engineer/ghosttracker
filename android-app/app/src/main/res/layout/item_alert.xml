<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_outlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top: type + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_alert_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ALERT"
                android:textAppearance="@style/TextAppearance.Magneetar.Overline"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_alert_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.Magneetar.Caption"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:alpha="0.5" />
        </LinearLayout>

        <!-- Message -->
        <TextView
            android:id="@+id/tv_alert_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alert received"
            android:textAppearance="@style/TextAppearance.Magneetar.Body2"
            android:textColor="@color/md_theme_onSurface" />

        <!-- Device -->
        <TextView
            android:id="@+id/tv_alert_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.Magneetar.Caption"
            android:textColor="@color/md_theme_onSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
