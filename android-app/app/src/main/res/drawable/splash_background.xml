<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Black background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Subtle green radial glow behind logo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#1800FF88"
                android:endColor="#0000FF88" />
        </shape>
    </item>
    <!-- Centered Magneetar logo (vector drawable) -->
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp"
        android:drawable="@drawable/magneetar_logo" />
</layer-list>
