<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════
         Magneetar Material Design 3 Dark Theme
         ═══════════════════════════════════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryDark">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorAccent">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- System -->
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>
        <item name="android:statusBarColor">@color/md_theme_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Typography — using system sans-serif -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Magneetar.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Magneetar.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Magneetar.Headline3</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Magneetar.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Magneetar.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Magneetar.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Magneetar.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Magneetar.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Magneetar.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Magneetar.Overline</item>
    </style>

    <!-- Splash theme: shows Magneetar logo instantly on cold start -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>
        <item name="android:statusBarColor">@color/md_theme_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Typography — System sans-serif with proper weights
         ═══════════════════════════════════════════════════════════════════ -->
    <style name="TextAppearance.Magneetar.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Magneetar.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Magneetar.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Magneetar.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Magneetar.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Magneetar.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.Magneetar.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.Magneetar.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Magneetar.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Magneetar.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Component Styles
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Primary Button -->
    <style name="Widget.Magneetar.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Secondary Button (Outlined) -->
    <style name="Widget.Magneetar.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Text Button -->
    <style name="Widget.Magneetar.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Card -->
    <style name="Widget.Magneetar.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/md_theme_surfaceContainerLow</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.Magneetar.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/md_theme_surface</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemRippleColor">@color/md_theme_primary</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Magneetar.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/md_theme_surface</item>
        <item name="titleTextColor">@color/md_theme_onSurface</item>
        <item name="subtitleTextColor">@color/md_theme_onSurfaceVariant</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Translucent theme for splash/transparent activities
         ═══════════════════════════════════════════════════════════════════ -->
    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
